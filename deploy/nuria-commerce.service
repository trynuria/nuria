[Unit]
Description=Nuria isolated payment execution and purchase evidence
After=network-online.target nuria-cognition.service

[Service]
User=nuria-commerce
Group=nuria-commerce
SupplementaryGroups=nuria-code nuria-public
WorkingDirectory=/opt/nuria/commerce-current
ExecStart=/opt/nuria/commerce-venv/bin/python -m commerce.worker
EnvironmentFile=/etc/nuria-commerce/rpc.env
Environment=NURIA_COMMERCE_CONFIG=/etc/nuria-commerce/policy.json
Environment=NURIA_COMMERCE_KEY=/etc/nuria-commerce/spending.json
Environment=NURIA_PRIVY_CREDENTIALS=/etc/nuria-commerce/privy.json
Environment=NURIA_NODE=/opt/nuria/node/bin/node
Environment=NURIA_COLLECTION_CONFIG=/etc/nuria-commerce/collection.json
Environment=NURIA_SWEEP_CONFIG=/etc/nuria-commerce/sweep.json
Environment=NURIA_CREATOR_PRIVY_CREDENTIALS=/etc/nuria-commerce/creator-privy.json
Environment=NURIA_CONVERSION_CONFIG=/etc/nuria-commerce/conversion.json
EnvironmentFile=-/etc/nuria-commerce/jupiter.env
Environment=NURIA_COMMERCE_DATA=/var/lib/nuria/commerce
Environment=NURIA_COMMERCE_PUBLIC=/var/lib/nuria/public/commerce
Environment=NURIA_COMMERCE_COGNITION=/var/lib/nuria/public/cognition
ReadWritePaths=/var/lib/nuria/commerce /var/lib/nuria/public/commerce
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TasksMax=64
MemoryMax=384M
CPUQuota=25%
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
